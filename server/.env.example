PORT=3000
ENABLE_SCHEDULERS=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HYXI_BASE_URL=https://open.hyxicloud.com
HYXI_ACCESS_KEY=
HYXI_ACCESS_SECRET=
GROWATT_BASE_URL=https://openapi.growatt.com
GROWATT_API_TOKEN=
GROWATT_TOKEN_ENCRYPTION_KEY=
# Orígenes permitidos por CORS en producción, separados por comas.
# Vacío = ningún Origin de navegador aceptado (solo requests sin Origin).
CORS_ORIGINS=
# Instrumentación de rendimiento HTTP (una línea http_metric por request).
# Desactivada por defecto; activar solo para diagnóstico.
HTTP_METRICS_ENABLED=false
